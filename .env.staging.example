# ==============================================================================
# VELTRAXX 2.0 - STAGING ENVIRONMENT TEMPLATE (COPY TO .env.staging.local)
# NEVER commit .env.staging.local or paste real secrets into chat/source files.
# Staging guard in scripts/restore_supabase.mjs and scripts/verify_staging_e2e.mjs
# blocks execution if SUPABASE_URL targets production ref krkiwilhwppqauyhwlcw.
# ==============================================================================

# --- Isolated Staging Supabase Project ---
VITE_SUPABASE_URL=https://YOUR_STAGING_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_STAGING_ANON_KEY
SUPABASE_URL=https://YOUR_STAGING_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_STAGING_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_STAGING_SERVICE_ROLE_KEY
VITE_USE_MOCK=false

# --- Google Drive OAuth2 API (Serverless / Vercel / Stage 3 Workspace) ---
GOOGLE_CLIENT_ID=YOUR_GCP_OAUTH_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GCP_OAUTH_CLIENT_SECRET
GOOGLE_REFRESH_TOKEN=YOUR_DRIVE_OFFLINE_REFRESH_TOKEN
GOOGLE_DRIVE_ROOT_FOLDER_ID=YOUR_PRIVATE_STAGING_DRIVE_FOLDER_ID
GOOGLE_DRIVE_RECEIPTS_FOLDER_ID=YOUR_PRIVATE_STAGING_RECEIPTS_FOLDER_ID

# --- Google Apps Script Staging Webhook & Cron Secret ---
GAS_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_STAGING_DEPLOYMENT_ID/exec
VITE_GOOGLE_APPS_SCRIPT_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_STAGING_DEPLOYMENT_ID/exec
GAS_SHARED_SECRET=YOUR_HIGH_ENTROPY_HMAC_SHARED_SECRET
CRON_SECRET=YOUR_HIGH_ENTROPY_CRON_SECRET
